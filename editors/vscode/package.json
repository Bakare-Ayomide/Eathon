{
  "name": "eathon-language-support",
  "displayName": "Eathon Language Support (.eat)",
  "description": "Syntax highlighting, indentation rules, and punctuation diagnostics for the Eathon programming language (.eat).",
  "version": "1.1.0",
  "publisher": "eathon-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "eathon",
        "aliases": [
          "Eathon",
          "eathon"
        ],
        "extensions": [
          ".eat",
          ".eatql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "eathon",
        "scopeName": "source.eathon",
        "path": "./syntaxes/eathon.tmLanguage.json"
      }
    ]
  }
}
