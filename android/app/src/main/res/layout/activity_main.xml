<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16">

    <!-- Top Application Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#111827">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#10B981"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="eathon native JNI ready" />
    </LinearLayout>

    <!-- Action Toolbar (Run, Open .eat, Save .eat, Import Folder, Export C99, EathonDB) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:paddingHorizontal="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRun"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="▶ Compile &amp; Run"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Open .eat"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Save .eat"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnImportFolder"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Import Folder"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExportC99"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Export C99"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnEatDb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Run EathonDB"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Quick English-Notes Snippet / Autocomplete Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:paddingHorizontal="6dp">

        <LinearLayout
            android:id="@+id/snippetBarContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Code Editor Area (60% height) -->
    <EditText
        android:id="@+id/codeEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="#090D16"
        android:textColor="#E2E8F0"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:importantForAutofill="no" />

    <!-- Native Execution & Diagnostic Output Console (40% height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:background="#05080F">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="NATIVE COMPILER &amp; EXECUTION CONSOLE (OFFLINE JNI)"
            android:textColor="#94A3B8"
            android:fontFamily="monospace"
            android:textSize="10sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <TextView
                android:id="@+id/consoleOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#10B981"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:text="Tap '▶ Compile &amp; Run' to compile and execute the .eat program natively." />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
